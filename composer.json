{
    "name": "roundly-consulting/campaigns-for-laravel",
    "description": "Send campaigns to multiple recipients",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "campaigns"
    ],
    "homepage": "https://github.com/roundly-consulting/campaigns-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/contacts-for-laravel": "@dev",
        "roundly-consulting/enums-for-laravel": "@dev",
        "roundly-consulting/options-for-laravel": "@dev",
        "roundly-consulting/package-toolkit-for-laravel": "@dev"
    },
    "repositories": [
        { "type": "path", "url": "../contacts-for-laravel*", "options": { "symlink": true } },
        { "type": "path", "url": "../options-for-laravel*", "options": { "symlink": true } },
        { "type": "path", "url": "../enums-for-laravel*", "options": { "symlink": true } },
        { "type": "path", "url": "../package-toolkit-for-laravel*", "options": { "symlink": true } },
        { "type": "path", "url": "../addresses-for-laravel*", "options": { "symlink": true } },
        { "type": "path", "url": "../connections-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/contacts-for-laravel", "no-api": true },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/options-for-laravel", "no-api": true },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/enums-for-laravel", "no-api": true },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/package-toolkit-for-laravel", "no-api": true },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/addresses-for-laravel", "no-api": true },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/connections-for-laravel", "no-api": true },
        { "type": "path", "url": "../testing-for-laravel*", "options": { "symlink": true } },
        { "type": "vcs", "url": "https://github.com/roundly-consulting/testing-for-laravel", "no-api": true }
    ],
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0",
        "roundly-consulting/testing-for-laravel": "@dev"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Campaigns\\": "src",
            "RoundlyConsulting\\Campaigns\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Campaigns\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Campaigns\\CampaignsServiceProvider"
            ],
            "aliases": {
                "Campaigns": "RoundlyConsulting\\Campaigns\\Facades\\Campaigns"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
